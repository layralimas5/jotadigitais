# Número de WhatsApp do suporte, só dígitos com DDI (ex.: 5511999999999). Vazio esconde o botão.
VITE_WHATSAPP_NUMBER=
VITE_SITE_URL=https://jotadigitais.com.br

# Supabase (Project Settings > API). Sem estas duas, site e painel rodam em modo demonstração,
